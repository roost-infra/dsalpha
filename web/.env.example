# Copy to .env.local for `pnpm dev`, or .env.production.local for `pnpm build`.
# Every value here is compiled into the client; never put a secret in this file.

# platform = hosted accounts/quotas; oss = self-hosted, no account portal.
VITE_HOST_MODE=platform

# Supabase project used for sign-in. In a deployment that proxies Supabase
# through its own origin, point these at that path instead (see docs/roost-billing.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The account portal the app links to for plans, usage and billing.
# Leave unset in OSS builds: the account entries then render as text, not links.
# A path on this origin (/account) or an absolute URL, no trailing slash.
# VITE_PLATFORM_URL=/account
# VITE_ROOST_CONSOLE_URL=https://www.roostbots.com/console/

# Optional per-destination overrides. A self-hosted portal whose section URLs
# differ from the Roost Console's hash sections sets these instead of relying
# on the defaults (plans→#plans, usage→#products, billing→#billing).
# VITE_ROOST_CONSOLE_PLANS_URL=
# VITE_ROOST_CONSOLE_USAGE_URL=
# VITE_ROOST_CONSOLE_BILLING_URL=

# Where the desktop app is downloaded from. Empty string hides the entry point.
# VITE_DESKTOP_DOWNLOAD_URL=https://example.com/app

# Support address shown in the UI, and the privacy policy link (optional).
# VITE_CONTACT_EMAILS=
# VITE_PRIVACY_URL=

# Optional: scope the auth/locale cookie to a parent domain so sibling
# subdomains share one session (single sign-on).
# VITE_COOKIE_DOMAIN=.example.com

# Feature flags (defaults are in the code).
# VITE_AUTH_SIGNUP_ENABLED=
# VITE_AUTH_OAUTH_ENABLED=
